# Rendered by the nginx image entrypoint (envsubst) at container start.
# Upstreams use "resolve" (nginx >= 1.27.3): DNS is re-resolved at run time,
# so the site starts before the APIs and follows Service IP changes, while
# keepalive pools reuse connections (no ephemeral-port exhaustion under load).
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

upstream banner_api {
    zone banner_api 64k;
    server ${BANNER_UPSTREAM} resolve;
    keepalive 256;
}

upstream collector_api {
    zone collector_api 64k;
    server ${COLLECTOR_UPSTREAM} resolve;
    keepalive 256;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/json;

    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store";
        return 200 'window.PROVIEW_CONFIG = { bannerEndpoint: "${BANNER_ENDPOINT}", collectorEndpoint: "${COLLECTOR_ENDPOINT}", debug: new URLSearchParams(location.search).has("debug") };\n';
    }

    location /sdk/ {
        add_header Cache-Control "public, max-age=300";
    }

    location /banners/ {
        add_header Cache-Control "public, max-age=86400";
        add_header Access-Control-Allow-Origin "*";
    }

    # Same-origin proxy to the APIs (used when *_ENDPOINT are empty).
    location = /v1/banner {
        proxy_pass http://banner_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
    }

    location = /v1/events {
        proxy_pass http://collector_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        client_max_body_size 64k;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}

server {
    listen 9090;
    access_log off;
    location = /healthz { return 200 "ok\n"; }
    location = /readyz  { return 200 "ready\n"; }
}
